{
  "name": "wazoo-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "launch:create-control-db": "node scripts/create-control-db.mjs",
    "launch:apply-schema": "node scripts/apply-control-schema.mjs",
    "launch:seed-admin": "node scripts/seed-admin-token.mjs",
    "smoke:beta": "node scripts/private-beta-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier \"src/**/*.ts\" --write",
    "format:check": "prettier \"src/**/*.ts\" --check"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "hono": "^4.10.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "prettier": "^3.9.5",
    "typescript": "^5.9.2",
    "wrangler": "latest"
  }
}
