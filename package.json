{
  "name": "wazoo-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "launch:seed-admin-d1": "node scripts/seed-admin-token-d1.mjs",
    "launch:seed-admin-d1": "node scripts/seed-admin-token-d1.mjs",
    "health:beta": "node scripts/private-beta-health.mjs",
    "health:local": "node scripts/local-health.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier \"src/**/*.ts\" \"tests/**/*.ts\" --write",
    "format:check": "prettier \"src/**/*.ts\" \"tests/**/*.ts\" --check"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "@hono/zod-openapi": "^1.5.1",
    "@workos-inc/node": "^10.8.0",
    "@worlds/client": "npm:@jsr/worlds__client@^0.1.0",
    "hono": "^4.10.3",
    "resend": "^6.17.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  }
}
