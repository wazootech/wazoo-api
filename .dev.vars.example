# Local development variables for wazoo-api.
# Copy this file to `.dev.vars` and fill in real values.
# The control plane uses Wrangler's local D1 binding; no database URL is needed.

# Platform API base URL used by health scripts and local wrangler dev.
API_BASE_URL="http://localhost:8787"

# Local D1 control-plane database is managed by Wrangler.
# Apply schema with: npx wrangler d1 migrations apply wazoo-api --local

# Data-plane API used for world storage/query/import/export.
WORLDS_API_URL="http://localhost:8081"

# Admin key that worlds-api accepts for provisioning and API-key management.
# Must match the WORLDS_ADMIN_KEY secret configured on the worlds-api Worker.
WORLDS_API_ADMIN_KEY="replace_me"

# Deployment environment label.
WAZOO_ENV="dev"

# Global platform admin token. Used by local health checks and seed scripts.
# Generate with: CLOUDFLARE_D1_DATABASE=wazoo-api npm run launch:seed-admin-d1
WAZOO_PLATFORM_ADMIN_TOKEN="replace_me"

# Optional Stripe configuration.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_PRICE_ID="price_replace_me"
