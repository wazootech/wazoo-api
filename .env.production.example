# Production environment reference for wazoo-api
# Copy this file to `.env.production` and fill in real values.
# These values are used for local scripts and ad-hoc commands against production.
# Runtime secrets on the production Worker are set via `wrangler secret put`.

API_BASE_URL="https://api.wazoo.dev"
WORLDS_API_URL="https://worlds-api.wazoo.dev"
WAZOO_ENV="prod"

# Control-plane libSQL database.
TURSO_DATABASE_URL="libsql://wazoo-platform-prod-ethanthatonekid.aws-us-west-2.turso.io"
TURSO_AUTH_TOKEN="<create with: turso db tokens create wazoo-platform-prod>"

# Turso organization/group used by launch scripts.
TURSO_ORG="ethanthatonekid"
TURSO_GROUP="wazoo"

# Turso platform API token.
TURSO_PLATFORM_API_TOKEN="<your-turso-platform-api-token>"

# Admin key shared with worlds-api production Worker.
WORLDS_API_ADMIN_KEY="<must match WORLDS_ADMIN_KEY secret on worlds-api>"

# Global platform admin token for production.
# Generate and seed with:
#   TURSO_DATABASE_URL=... TURSO_AUTH_TOKEN=... npm run launch:seed-admin
WAZOO_PLATFORM_ADMIN_TOKEN="<prod-admin-token>"

# Optional Stripe production configuration.
STRIPE_SECRET_KEY="sk_live_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_PRICE_ID="price_replace_me"
